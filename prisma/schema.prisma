// Esquema de base de datos - Módulo de autenticación
// Basado en RF01 (Autenticación y Gestión de Usuarios) y RNF-02 (Seguridad y Protección de Datos)
// del documento de requerimientos de Magnus|SIG.

// Prisma 7: la URL de conexión (DATABASE_URL) NO va en el datasource;
// se define en prisma7.config.ts. No agregar `url = env(...)` aquí.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMINISTRADOR
  EVALUADOR_SST
  TRABAJADOR
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

enum TipoCodigo {
  VERIFICACION_EMAIL
  RESET_PASSWORD
}

model Usuario {
  id               String        @id @default(uuid())
  nombre           String
  apellido         String
  email            String        @unique
  passwordHash     String
  rol              Rol           @default(TRABAJADOR)
  estado           EstadoUsuario @default(ACTIVO)
  emailVerificado  Boolean       @default(false)
  intentosFallidos Int           @default(0)
  bloqueadoHasta   DateTime?
  fechaRegistro    DateTime      @default(now())

  codigos CodigoVerificacion[]

  @@map("usuarios")
}

model CodigoVerificacion {
  id        String     @id @default(uuid())
  usuarioId String
  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codigo    String
  tipo      TipoCodigo
  expiraEn  DateTime
  usado     Boolean    @default(false)
  creadoEn  DateTime   @default(now())

  @@index([usuarioId, tipo])
  @@map("codigos_verificacion")
}
