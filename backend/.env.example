ENV="development"
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/magnussing"
# Base de datos exclusiva para pruebas: su nombre debe contener la palabra "test".
TEST_DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/magnussing_test"

PORT=4000
FRONTEND_URL="http://localhost:5173"
JWT_SECRET="cambia-este-valor-por-una-cadena-larga-y-aleatoria"
# Obligatoria para guardar respuestas. Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=""

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS="tu_contrasena_de_aplicacion"
SMTP_FROM="Magnus|SIG <noreply@tudominio.com>"

ADMIN_EMAIL="admin@magnussig.com"
ADMIN_PASSWORD="Admin1234"
ADMIN_NOMBRE="Administrador"
ADMIN_APELLIDO="Sistema"

STORAGE_PATH="./storage"
MIN_GRUPO_ANONIMATO=5

# Wompi (pasarela de pago). Con ENV="production" las cuatro llaves son obligatorias.
# Sandbox: https://sandbox.wompi.co/v1
WOMPI_API_URL="https://sandbox.wompi.co/v1"
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
# Secreto de integridad (firma del checkout)
WOMPI_INTEGRITY_SECRET=""
# Secreto de eventos (firma del webhook). Sin este valor el webhook responde 503.
WOMPI_EVENTS_SECRET=""
# El webhook debe registrarse en el panel de Wompi como:
#   https://TU_DOMINIO/api/wompi/events