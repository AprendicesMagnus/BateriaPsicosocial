# Copia este archivo como ".env" y completa los valores.

# Cadena de conexión a PostgreSQL (local, Docker, o un servicio como Render/Neon/Supabase)
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/magnussing?schema=public"

# Puerto del servidor de la API
PORT=4000

# Origen permitido para CORS (URL del frontend en desarrollo)
FRONTEND_URL="http://localhost:5173"

# Secreto para firmar los tokens JWT de sesión y de restablecimiento de contraseña
JWT_SECRET="cambia-este-valor-por-una-cadena-larga-y-aleatoria"

# --- Envío de correos (opcional en desarrollo) ---
# Si dejas SMTP_HOST vacío, los códigos de verificación se imprimen en la consola
# del backend en lugar de enviarse por correo, para que puedas probar sin credenciales SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Magnus|SIG <no-reply@magnussig.local>"
